# Base da API .NET
NEXT_PUBLIC_API_URL=http://localhost:5120
# URL canônica do site (metadata/SEO/sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp da artista (formato internacional, só dígitos). Ex.: 5547999999999
NEXT_PUBLIC_WHATSAPP=

# ── Autenticação (NextAuth) ─────────────────────────────────────────
# URL pública do site (mesma do NEXT_PUBLIC_SITE_URL)
NEXTAUTH_URL=http://localhost:3000
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=
# OAuth Client do Google Cloud Console (tipo "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional (produção): URL interna da API para chamadas servidor→servidor
# INTERNAL_API_URL=http://127.0.0.1:5120
